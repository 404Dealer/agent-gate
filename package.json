{
  "name": "nightdrop",
  "version": "0.1.0",
  "description": "Deterministic approval layer between AI agents and external actions",
  "type": "module",
  "bin": {
    "nightdrop": "./dist/index.js",
    "nightdrop-oauth": "./scripts/oauth-setup.sh",
    "nightdrop-smtp-setup": "./scripts/smtp-setup.sh",
    "nightdrop-mailbox-cleanup": "./scripts/mailbox-cleanup.sh",
    "nightdrop-mailbox": "./dist/mailbox-client.js"
  },
  "files": [
    "dist/",
    "docs/",
    "config.example.yaml",
    "scripts/oauth-setup.sh",
    "scripts/smtp-setup.sh",
    "scripts/mailbox-cleanup.sh"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "keywords": [
    "ai-agent",
    "agent-security",
    "prompt-injection",
    "email-approval",
    "telegram-bot",
    "deterministic",
    "human-in-the-loop",
    "llm-safety"
  ],
  "author": "Johnny Ramirez <engineer@johnnyr.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/404Dealer/nightdrop.git"
  },
  "homepage": "https://github.com/404Dealer/nightdrop#readme",
  "bugs": {
    "url": "https://github.com/404Dealer/nightdrop/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "grammy": "^1.35.1",
    "imapflow": "1.4.6",
    "mailparser": "3.9.14",
    "nodemailer": "9.0.3",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mailparser": "3.4.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2"
  }
}
