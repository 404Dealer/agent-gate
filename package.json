{
  "name": "agent-gate",
  "version": "0.1.0",
  "description": "Deterministic approval layer between AI agents and external actions",
  "type": "module",
  "bin": {
    "agent-gate": "./dist/index.js",
    "agent-gate-oauth": "./dist/oauth-setup.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "keywords": [
    "ai-agent",
    "agent-security",
    "prompt-injection",
    "email-approval",
    "telegram-bot",
    "deterministic",
    "human-in-the-loop",
    "llm-safety"
  ],
  "author": "Johnny Ramirez <engineer@johnnyr.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/404Dealer/agent-gate.git"
  },
  "homepage": "https://github.com/404Dealer/agent-gate#readme",
  "bugs": {
    "url": "https://github.com/404Dealer/agent-gate/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "grammy": "^1.35.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2"
  }
